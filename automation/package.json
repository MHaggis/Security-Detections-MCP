{
  "name": "autonomous-detection-platform",
  "version": "3.0.0",
  "private": true,
  "description": "SQLite threat-intelligence queue with an explicit detection-agents CLI adapter",
  "type": "commonjs",
  "main": "dist/runners/autonomous-loop.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "node dist/runners/autonomous-loop.js start",
    "collect": "node dist/collectors/cisa-rss-collector.js once",
    "loop": "node dist/runners/autonomous-loop.js once",
    "scheduler": "node dist/runners/cron-scheduler.js",
    "report": "node dist/reports/report-generator.js weekly",
    "approvals": "node dist/hitl/approval-system.js",
    "migrate": "node dist/db.js",
    "test:agents": "npm run build && node tests/agents-integration.cjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "cron": "4.4.0",
    "rss-parser": "3.13.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
